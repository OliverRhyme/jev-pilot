# Copy to .env and fill in. Never commit the real file.
#
# The key is read at runtime and is never compiled into the binary.
TYPESAFE_API_KEY=

# Preferred for services: point at a mounted secret file instead, so the key
# is not visible in the process environment. Takes precedence over the above.
# TYPESAFE_API_KEY_FILE=/run/secrets/typesafe-api-key
