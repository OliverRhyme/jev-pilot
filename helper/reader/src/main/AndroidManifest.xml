<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Needed to open a ServerSocket at all, even one bound to loopback. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Reads the screen through UiAutomation, which is refused no window
         where an accessibility service is refused several. It lives in its own
         package on purpose: an instrumentation runs in its target package's
         process, so stopping it kills whatever shares that package. When that
         was the accessibility service, every stop left it enabled, unbound and
         never rebound. -->
    <instrumentation
        android:name="dev.jevpilot.reader.PilotInstrumentation"
        android:targetPackage="dev.jevpilot.reader"
        android:label="Jev Pilot screen reader" />

    <application
        android:allowBackup="false"
        android:hasFragileUserData="false"
        android:label="Jev Pilot Reader"
        android:usesCleartextTraffic="false">

        <!-- Session token drop. Only a sender holding WRITE_SECURE_SETTINGS -
             the adb shell user, or the system - can deliver this, so no
             ordinary app on the device can set a token of its own and then
             talk to the loopback server. -->
        <receiver
            android:name="dev.jevpilot.helper.TokenReceiver"
            android:exported="true"
            android:permission="android.permission.WRITE_SECURE_SETTINGS">
            <intent-filter>
                <action android:name="dev.jevpilot.reader.SET_TOKEN" />
            </intent-filter>
        </receiver>

    </application>

</manifest>
